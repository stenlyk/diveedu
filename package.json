{
  "name": "diveedu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "calc",
    "deco"
  ],
  "scripts": {
    "content": "tsx scripts/build-content.ts",
    "predev": "npm run content",
    "dev": "vite",
    "prebuild": "npm run content",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run e2e",
    "deploy": "npm run build && wrangler pages deploy dist --project-name diveedu --branch main"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "dexie": "^4.4.7",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "unified": "^11.0.5",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.161.0",
    "yaml": "^2.9.1"
  }
}
